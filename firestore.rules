rules_version = '2';

// Firestore security rules for the `posts` collection.
//
// All CMS reads and writes go through the Next.js server using the Firebase
// Admin SDK, which bypasses these rules. Client SDKs therefore need no access
// at all — locking the database down entirely is the safest posture, and it
// costs nothing because no browser talks to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
