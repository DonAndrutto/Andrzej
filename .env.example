# ──────────────────────────────────────────────────────────────────────────────
# arybszleger.com — environment configuration
#
# Copy to `.env.local` for local development. On Vercel, set these in
# Project Settings → Environment Variables.
#
# EVERYTHING here is optional for local development: without any Firebase
# configuration the site runs entirely on the file-based content backend
# (content/posts/*.md + public/uploads/), and the admin dashboard can be
# unlocked with ADMIN_DEV_PASSWORD.
# ──────────────────────────────────────────────────────────────────────────────

# Canonical site origin. Used for metadata, sitemap, RSS and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://arybszleger.com

# ── Content backend ───────────────────────────────────────────────────────────
# "fs"        → posts live in content/posts/*.md, images in public/uploads/
#               (default when Firebase Admin is not configured)
# "firestore" → posts live in Firestore, images in Firebase Storage
#               (default when Firebase Admin IS configured)
# Set explicitly only to override the automatic choice.
# CONTENT_BACKEND=fs

# ── Firebase client SDK (browser) — from Firebase console → Project settings ──
# Required for admin sign-in with Firebase Authentication.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server) ───────────────────────────────────────────────
# Service account JSON for the same project, as a single-line JSON string
# (Firebase console → Project settings → Service accounts → Generate key).
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a key file path.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Admin access control ──────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed into the admin dashboard.
# REQUIRED in production: Firebase Auth authenticates anyone with an account;
# this allowlist decides who is an administrator.
# ADMIN_ALLOWED_EMAILS=owner@example.com

# Development-only fallback: unlocks /admin without Firebase.
# Ignored in production unless ADMIN_DEV_PASSWORD_ALLOW_PRODUCTION=true
# (never do that on a real deployment).
# ADMIN_DEV_PASSWORD=choose-a-long-random-string
